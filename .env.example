# AetherRide — lokale Secrets (nicht committen: .env.local)

# ── Supabase Auth + Postgres ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQL: supabase/migrations/20260806_profiles_and_sync.sql
# FORCE_FILE_SYNC=true

# Legacy-Fallback ohne Supabase
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── Stripe Marketplace (Roadmap 5) ──
# Spec: erst bei belegter Nachfrage — Flag bewusst setzen:
# STRIPE_DEMAND_DOCUMENTED=true
# NEXT_PUBLIC_STRIPE_DEMAND_DOCUMENTED=true
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook-URL: {SITE_URL}/api/stripe/webhook

# ── OAuth Google/Apple (zum Schluss) ──
# NEXT_PUBLIC_OAUTH_ENABLED=true
