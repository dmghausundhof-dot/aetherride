# --- App URL (local or your Vercel URL on the correct account) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example:
# NEXT_PUBLIC_APP_URL=https://aetherride.vercel.app
# NEXT_PUBLIC_SITE_URL=https://aetherride.app

# --- Mobile stores & deep links ---
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id…
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.aetherride.aetherride_mobile
# NEXT_PUBLIC_IOS_TEAM_ID=
# NEXT_PUBLIC_IOS_BUNDLE_ID=io.aetherride.app
# NEXT_PUBLIC_ANDROID_PACKAGE=com.aetherride.aetherride_mobile
# Comma-separated SHA-256 (colon form). Debug keystore: bash scripts/ops-android-auth.sh
# NEXT_PUBLIC_ANDROID_SHA256_FINGERPRINTS=EB:A0:B0:B6:…,PLAY_APP_SIGNING_SHA…
# NEXT_PUBLIC_ANDROID_SHA256_FINGERPRINTS=

# --- Shopify Storefront (featured-parts Collection, Headless) ---
# Öffentliche Storefront-URL für App-Gateway (Custom Tabs) und Theme.
# Kein Secret. Flutter: --dart-define=SHOPIFY_STOREFRONT_URL=…
# SHOPIFY_STOREFRONT_URL=https://dmg-haus-und-hof-shop.myshopify.com
# Domain ohne https:// — Default: dmg-haus-und-hof-shop.myshopify.com
# SHOPIFY_STORE_DOMAIN=dmg-haus-und-hof-shop.myshopify.com
# Headless Storefront API token (Admin → Apps → Develop apps → Storefront API)
# Do NOT put the Online Store password in NEXT_PUBLIC_* or client bundles.
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_STOREFRONT_API_VERSION=2025-01
# Online Store password wall? Default true until public launch.
# Flutter: --dart-define=SHOPIFY_ONLINE_STORE_LOCKED=false after Admin unlock.
# Admin click-path: Online Store → Preferences → Password protection → Restrict access… off → Save.
# SHOPIFY_ONLINE_STORE_LOCKED=true
# Optional Eng-only smoke (server/scripts) — NEVER expose via API / NEXT_PUBLIC_:
# SHOPIFY_STOREFRONT_PASSWORD=

# Admin API (Garage-Bike Fit-Hook, Draft-Produkt). Ohne Token: „Shop nicht verbunden“.
# Custom App → Admin API access token (shpat_…). Nie NEXT_PUBLIC_*.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# SHOPIFY_ADMIN_API_VERSION=2025-01
# Optional Merchandise-Collection (Default: merchandise)
# SHOPIFY_MERCH_COLLECTION=merchandise

