# CHAT_LIMIT_FREE_MONTH=40
# CHAT_LIMIT_PRO_DAY=50
# CHAT_LIMIT_PRO_MONTH=500
# CHAT_LIMIT_ANON_DAY=5

# --- Legal (Marketplace — Pflicht; Impressum ohne Name/Anschrift = TMG unvollständig) ---
# Mehrzeiliger TMG-Text: Name, ladungsfähige Anschrift, ggf. Register, USt-IdNr.
NEXT_PUBLIC_LEGAL_IMPRINT=
# Öffentliche Kontaktmail (UI-Fallback: hello@aetherride.app)
NEXT_PUBLIC_LEGAL_EMAIL=hello@aetherride.app
NEXT_PUBLIC_LEGAL_PRIVACY=
NEXT_PUBLIC_LEGAL_WITHDRAWAL=
NEXT_PUBLIC_LEGAL_SHIPPING=
NEXT_PUBLIC_LEGAL_WARRANTY=
NEXT_PUBLIC_LEGAL_GPSR=
NEXT_PUBLIC_LEGAL_DISPUTE=
NEXT_PUBLIC_LEGAL_BATTERY=

# --- Mapillary (Trail View) ---
MAPILLARY_ACCESS_TOKEN=
# NEXT_PUBLIC_MAPILLARY_ACCESS_TOKEN=

# --- Strava (OAuth + upload; ohne Keys nur Stub/GPX) ---
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Optional HMAC (sonst CLIENT_SECRET): STRAVA_STATE_SECRET=
# Strava App Redirect URI: {NEXT_PUBLIC_APP_URL}/api/strava/callback
# Supabase Auth Redirect (Mobile): io.aetherride.app://login-callback/

# --- Routing ---
# OpenRouteService (HeiGIT) — DACH cycling-road/regular/mountain/electric.
# Dashboard: https://openrouteservice.org/dev/#/home
# OPENROUTESERVICE_API_KEY=
# Alias: ORS_API_KEY=
# OPENROUTESERVICE_URL=https://api.openrouteservice.org
# Wenn gesetzt (und ROUTING_ENGINE leer): Primary-Engine für ganz DACH.
# Hybrid: GraphHopper Primary + ORS für gravel/mtb/enduro solange
# GRAPHHOPPER_ALLOW_EXTENDED_PROFILES nicht 1 ist.
# Primary: GraphHopper Cloud (https://graphhopper.com/dashboard/)
ROUTING_ENGINE=graphhopper
GRAPHHOPPER_API_KEY=
# Optional: https://graphhopper.com/api/1 (default)
# GRAPHHOPPER_URL=https://graphhopper.com/api/1
# Set to 1 if your plan allows mtb|hike|racingbike (Basic often only car|bike|foot)
# GRAPHHOPPER_ALLOW_EXTENDED_PROFILES=1
# Stadia Maps — hosted Valhalla + vector tiles (https://client.stadiamaps.com/)
STADIA_API_KEY=
# Browser MapLibre styles (restrict key by domain in Stadia dashboard):
NEXT_PUBLIC_STADIA_API_KEY=
# Optional: use Stadia Valhalla instead of GraphHopper / self-host
# ROUTING_ENGINE=valhalla
# VALHALLA_URL=https://api.stadiamaps.com
# Optional self-host / fallback:
VALHALLA_URL=
OSRM_URL=
# Dev: ohne Key Live über project-osrm.org (ehrlich gelabelt). Production: false.
# ALLOW_PUBLIC_OSRM=true
# ALLOW_PUBLIC_OSRM=false
# Fake-Routing / Demo-Geometrie nur Dev. Production fail-closed.
# Kuratierte P0 Discover-Seeds (Berlin/RN Katalog) sind davon unabhängig.
# ALLOW_DEMO_CONTENT=false
# ALLOW_DEMO_CONTENT=true
# Nach erfolgreichem Routing-Smoke setzen (sonst UI zeigt „nicht verifiziert“):
# NEXT_PUBLIC_ROUTING_LIVE=1
# Show Demo-Geometrie / Routing-Key / OA-unconfigured / Heatmap-offline banners.
# Fail-closed: ONLY "1" enables (not "true"). Prod: leave unset.
# NEXT_PUBLIC_SHOW_ROUTING_DEBUG=1
# Flutter: Demo-Geometrie / Routing-Key chrome in Discover (dart-define). Prod: leave unset.
# SHOW_ROUTING_DEBUG=true
# Vector tiles for MapLibre (Protomaps/OSM extracts on the CDN).
# Empty NEXT_PUBLIC_PMTILES_URL still uses the catalog (DACH / France-west /
# Alps-south / Benelux / Italy-north / Italy-center / Italy-south /
# Catalonia-Pyrenees / UK-south)
# and switches by viewport — do not rely on a single DACH URL.
# Override with a street-level style JSON to lock (no bbox switch).
NEXT_PUBLIC_PMTILES_URL=https://krmgatsugplouzrhhozn.supabase.co/storage/v1/object/public/offline-packs/basemap/dach-z11-style.json

# --- Google Maps Platform (Places POIs + Geocoding fallback, optional) ---
# Server-only — NEVER NEXT_PUBLIC_ (would leak + ToS: no Google tiles on MapLibre).
# GPS/viewport radius only. OSM/MapLibre stays map truth.
# GOOGLE_MAPS_API_KEY=
# Enable APIs only on an AetherRide GCP project (script refuses others):
#   bash scripts/gcloud-maps-apis.sh
# Then: vercel env add GOOGLE_MAPS_API_KEY

# --- Outdooractive (DACH enrichment, optional) ---
# OUTDOORACTIVE_API_KEY=
# OUTDOORACTIVE_PROJECT_KEY=

# --- Trailforks (attribution only until Legal partnership) ---
# TRAILFORKS_MODE=attribution_only

# --- Play Billing (mobile verify — trusted token until Google API 2A) ---
# Optional explicit stub flag (same trusted-token path as default without Google creds):
# PLAY_VERIFY_STUB=1
# Later (2A): service-account JSON for Android Publisher API
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# --- Offline region packs (Supabase Storage public bucket) ---
# ROUTING_CDN_BASE=https://krmgatsugplouzrhhozn.supabase.co/storage/v1/object/public/offline-packs


# --- Sentry (Flutter crash reporting) ---
# Compile-time: flutter run/build --dart-define=SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Empty = disabled (local debugPrint only). Never commit the DSN. Never NEXT_PUBLIC_ / never print it.
# SENTRY_DSN=
