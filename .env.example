# AetherRide — lokale Secrets (nicht committen: .env.local)

# ── Supabase Auth + Postgres ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQL: supabase/migrations/20260806_profiles_and_sync.sql
# FORCE_FILE_SYNC=true

# Legacy-Fallback ohne Supabase
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── OAuth Google/Apple (Roadmap 9) ──
# 1) Supabase Dashboard → Authentication → Providers → Google / Apple
# 2) Redirect URL: {NEXT_PUBLIC_SITE_URL}/auth/callback
# 3) Feature-Flag:
NEXT_PUBLIC_OAUTH_ENABLED=true
# Optional pro Provider (Default an wenn Master-Flag an):
# NEXT_PUBLIC_OAUTH_GOOGLE=true
# NEXT_PUBLIC_OAUTH_APPLE=true

# ── Stripe Marketplace ──
# STRIPE_DEMAND_DOCUMENTED=true
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
