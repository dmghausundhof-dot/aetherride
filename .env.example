# AetherRide — lokale Secrets (nicht committen: .env.local)

# ── Supabase Auth + Postgres ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional Server-Admin:
# SUPABASE_SERVICE_ROLE_KEY=

# Site-URL für Auth-Redirects (E-Mail-Confirm + später OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQL-Migration einmal ausführen:
#   supabase/migrations/20260806_profiles_and_sync.sql
# (Supabase SQL Editor oder `supabase db push`)

# Notfall: Sync/Profiles auf File zwingen
# FORCE_FILE_SYNC=true

# ── Legacy-Fallback (nur wenn Supabase-Env fehlt) ──
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── OAuth Google/Apple (zum Schluss) ──
# NEXT_PUBLIC_OAUTH_ENABLED=true

# Optional Stripe (Roadmap 5)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
