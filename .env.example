# AetherRide — lokale Secrets (nicht committen: .env.local)

# ── Supabase Auth (primär für E-Mail/Passwort) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional Server-Admin:
# SUPABASE_SERVICE_ROLE_KEY=

# Site-URL für Auth-Redirects (E-Mail-Confirm + später OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Legacy-Fallback (nur wenn Supabase-Env fehlt) ──
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ── OAuth Google/Apple (zum Schluss) ──
# Code + /auth/callback + /api/auth/oauth/start sind vorbereitet.
# 1) Provider im Supabase Dashboard aktivieren
# 2) Redirect URL: {NEXT_PUBLIC_SITE_URL}/auth/callback
# 3) Feature-Flag:
# NEXT_PUBLIC_OAUTH_ENABLED=true
# (Client-Secrets liegen im Supabase Dashboard, nicht zwingend hier)

# Optional Stripe (Roadmap 5)
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
