# AetherRide — Production env (copy to .env.local). Never commit secrets.

# --- Supabase (project aetherride / krmgatsugplouzrhhozn) ---
NEXT_PUBLIC_SUPABASE_URL=https://krmgatsugplouzrhhozn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImtybWdhdHN1Z3Bsb3V6cmhob3puIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwNDMxOTcsImV4cCI6MjEwMTYxOTE5N30.oxplxXQE2yp7HpwqTccI9urrZOjsgQRuiTrgrJXzGjE
# Dashboard → Project Settings → API → service_role (secret)
